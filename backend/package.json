{
  "name": "nuevo-origen-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:undo": "sequelize-cli db:migrate:undo",
    "test:mysql": "node --env-file-if-exists=.env scripts/test-mysql.js",
    "mysql:start": "node scripts/local-mysql.js start",
    "mysql:resume": "node scripts/local-mysql.js resume",
    "mysql:stop": "node scripts/local-mysql.js stop",
    "auth:configure": "node scripts/configure-auth.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.15.0",
    "sequelize": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.0",
    "supertest": "^7.1.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
