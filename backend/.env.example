NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nuevo_origen_development
DB_USER=nuevo_origen_dev
DB_PASSWORD=valor_ficticio
# Pruebas: usar variables separadas y exclusivamente la base siguiente.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=nuevo_origen_test
TEST_DB_USER=nuevo_origen_test
TEST_DB_PASSWORD=valor_ficticio
JWT_SECRET=CAMBIAR_con_auth_configure_no_usar_este_valor_ficticio
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:3001
SESSION_TTL_SECONDS=28800
# Motor local actual. PostgreSQL se ensaya mediante los scripts postgres:*.
DB_DIALECT=mysql
TEST_DB_DIALECT=mysql
# Solo backend. Configurar localmente; nunca enviar la clave por chat ni Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# true registra confirmación humana del ajuste real en la cuenta de Groq.
# No activa la retención cero en el proveedor por sí mismo.
GROQ_ZDR_CONFIRMED=false
